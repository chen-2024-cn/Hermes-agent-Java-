<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback 控制台日志配置。

  设计目标：
  1. 显式指定 UTF-8 编码，避免 Windows 控制台默认 GBK 导致中文日志乱码；
  2. 根级别默认 INFO，屏蔽 DEBUG 刷屏（原项目无配置时 logback 回退到 DEBUG，
     会打印大量第三方库调试日志）；
  3. 支持通过环境变量 HERMES_LOG_LEVEL 覆盖级别，便于排查：
     Windows PowerShell:  $env:HERMES_LOG_LEVEL="DEBUG"
     Linux/macOS:         HERMES_LOG_LEVEL=DEBUG java -jar ...
  4. com.cyk 自有代码默认 INFO；第三方库（okhttp/jsoup/playwright 等）压到 WARN，
     减少噪音，同时保留它们的错误信息。
-->
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- 简洁格式：时间 [级别] logger - 消息 -->
            <pattern>%d{HH:mm:ss.SSS} [%level] %logger{24} - %msg%n</pattern>
            <!-- 关键：强制 UTF-8，解决 Windows 控制台中文乱码 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Hermes 自有代码：默认 INFO，可用 HERMES_LOG_LEVEL 覆盖 -->
    <logger name="com.cyk" level="${HERMES_LOG_LEVEL:-INFO}"/>

    <!-- 第三方库降噪：仅保留 WARN 及以上 -->
    <logger name="okhttp3" level="WARN"/>
    <logger name="okio" level="WARN"/>
    <logger name="org.jsoup" level="WARN"/>
    <logger name="com.microsoft.playwright" level="WARN"/>
    <logger name="org.postgresql" level="WARN"/>

    <!-- 根 logger：兜底级别，防止未显式配置的库打印 DEBUG -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
